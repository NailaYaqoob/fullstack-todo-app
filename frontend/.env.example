# FastAPI backend base URL — used by lib/api.ts
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret — MUST be identical to BETTER_AUTH_SECRET in backend/.env
BETTER_AUTH_SECRET=<generate-with: openssl rand -base64 32>

# Better Auth instance URL (this app's own origin)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Neon Serverless PostgreSQL — Better Auth uses node-postgres (pg), not asyncpg
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
