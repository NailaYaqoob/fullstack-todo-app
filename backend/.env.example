# Neon Serverless PostgreSQL — use the asyncpg driver
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<db>?ssl=require

# Shared secret — MUST be identical to BETTER_AUTH_SECRET in frontend/.env.local
BETTER_AUTH_SECRET=<generate-with: openssl rand -base64 32>

# Public URL of the Better Auth instance (the frontend origin)
BETTER_AUTH_URL=http://localhost:3000

# Frontend origin — used for the CORS allowlist in main.py
FRONTEND_URL=http://localhost:3000

# OpenAI API key for the chatbot agent (003-chatbot)
OPENAI_API_KEY=sk-...

# OpenAI Agents SDK workflow ID for the chat agent
AGENT_WORKFLOW_ID=<workflow-id>
